# nekto-audio — LOCAL (Windows) config. Copy this file to ".env" and fill it in.
# Node loads it automatically with `npm run start:local`.

# REQUIRED — your Discord bot token.
DISCORD_TOKEN=

# Optional: comma-separated Discord user IDs allowed to control the bot.
# Defaults to the application owner.
BOT_OWNER_IDS=
# Optional: register slash commands to one guild instantly (vs global propagation).
DISCORD_GUILD_ID=

# Your pre-warmed nekto token (warm it in a real browser first: pass the captcha
# / do a chat or two, so the local bot's session skips the captcha).
NEKTO_AUTH_TOKEN=

DATA_DIR=./data
PORT=3000

# Optional: route the browser through a proxy (residential recommended).
# http://user:pass@host:port  or  socks5://user:pass@host:port
# NEKTO_PROXY=

# Optional: seconds to dwell on the page before the first Search click.
# NEKTO_START_DELAY_MS=5000

# The bot loads your token as a real MV3 extension (nekto prime) in a fresh,
# throwaway Chrome profile each session — same as using the extension manually,
# with a clean slate every time. Set this to 0 to instead inject the token via
# an init script into a plain incognito context (old behavior).
# NEKTO_USE_EXTENSION=1

# ----------------------------------------------------------------------------
# Leave everything below UNSET on a real Windows machine. These exist only for
# the Linux/Railway twin, where the browser must pretend to be Windows. On your
# own PC the real fingerprint is already correct — spoofing it only creates
# mismatches that get you flagged. Desktop auto-uses your visible, installed
# Chrome; no overrides needed.
# ----------------------------------------------------------------------------
# NEKTO_SPOOF_WIN=     # server only — leave empty locally
# NEKTO_SPOOF_GL=      # server only — leave empty locally
# NEKTO_TZ=            # server only — leave empty locally
# NEKTO_BROWSER_CHANNEL=  # leave empty; desktop already uses real Chrome
# NEKTO_HEADLESS=      # leave empty; desktop runs a visible window
